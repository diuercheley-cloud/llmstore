        }

        async function toggleModel(id, enable) {
            await apiFetch(`/admin/models/${id}/${enable ? 'enable' : 'disable'}`, 'POST');
            toast(`Modelo ${enable ? 'habilitado' : 'desabilitado'}.`, 'success');
            await loadTab('models');
        }

        async function resetCircuitBreaker() {
            await apiFetch('/admin/backends/circuit-breaker/reset', 'POST');
            toast('Circuit breaker resetado.', 'success');
            await loadTab('backends');
        }

        async function clearCache() {
            if (!confirm('Limpar todo o cache?')) return;
            await apiFetch('/admin/cache/responses', 'DELETE');
            toast('Cache limpo.', 'success');
            await loadTab('cache');
        }

        async function exportData(type, format = 'json') {
            window.open(`/admin/export/${type}?format=${format}`, '_blank');
        }

        async function probeInvalidAdmin() {
            const res = await fetch('/admin/clients', { headers: { 'X-Admin-Token': 'invalid-token' } });
            toast(`Admin token inválido => HTTP ${res.status}`);
        }

        async function probeInvalidApiKey() {
            const res = await fetch('/v1/models', { headers: { Authorization: 'Bearer sk-invalid-demo' } });
            toast(`API key inválida => HTTP ${res.status}`);
        }

        async function createTemporaryClientApiKey() {
            const client = state.clients.find((item) => item.name === 'demo-client') || state.clients[0];
            if (!client) throw new Error('Nenhum cliente disponível para teste.');
            const result = await apiFetch('/admin/api-keys', 'POST', { client_id: client.id, name: `lab-temp-${Date.now()}` });
            return result.api_key;
        }

        async function runCacheValidation() {
            const before = await apiFetch('/admin/cache/stats');
            const apiKey = await createTemporaryClientApiKey();
            const payload = {
                model: 'unsloth/gemma-4-E4B-it-GGUF',
                messages: [{ role: 'user', content: 'Repita exatamente esta frase curta para validar cache.' }],
                max_tokens: 32,
                stream: false,
            };
            for (let i = 0; i < 2; i += 1) {
                await fetch('/v1/chat/completions', {
                    method: 'POST',
                    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
            }
            const after = await apiFetch('/admin/cache/stats');
            state.cacheStats = after;
            renderCache();
            toast(`Cache testado. entries ${before.entries_total || 0} -> ${after.entries_total || 0}`);
        }

        async function runFlow(type) {
            const term = document.getElementById('terminal-output');
            term.classList.remove('hidden');
            term.textContent = `> fluxo ${type}\n`;
            try {
                if (type === 'client-full') {
                    const client = await apiFetch('/admin/clients', 'POST', { name: `Lab-Flow-${Date.now()}`, description: 'admin lab flow', billing_plan_id: state.plans.find((plan) => plan.code === 'basic')?.id || null });
                    term.textContent += `cliente=${client.id}\n`;
                    const key = await apiFetch('/admin/api-keys', 'POST', { client_id: client.id, name: 'flow-key' });
                    term.textContent += `key=${key.key_prefix}\n`;
                    const invoiceRes = await apiFetch('/admin/billing/invoices/generate', 'POST', { client_id: client.id, force: true });
                    const invoice = invoiceRes.created[0] || invoiceRes.updated[0];
                    term.textContent += `invoice=${invoice.id}\n`;
                    await apiFetch(`/admin/billing/invoices/${invoice.id}/mark-paid`, 'PATCH', { payment_method: 'flow_bot' });
                    term.textContent += `invoice paid\n`;
                } else if (type === 'past-due') {
                    const client = await apiFetch('/admin/clients', 'POST', { name: `Lab-PastDue-${Date.now()}` });
                    const invoiceRes = await apiFetch('/admin/billing/invoices/generate', 'POST', { client_id: client.id, force: true });
                    const invoice = invoiceRes.created[0] || invoiceRes.updated[0];
                    await apiFetch(`/admin/billing/invoices/${invoice.id}/mark-overdue`, 'PATCH');
                    await apiFetch('/admin/billing/run-cycle', 'POST');
                    term.textContent += `invoice overdue and cycle executed\n`;
                } else if (type === 'cache') {
                    await runCacheValidation();
                    term.textContent += 'cache validation completed\n';
                }
                term.textContent += 'ok\n';
            } catch (err) {
                term.textContent += `error: ${err.message}\n`;
            }
        }

    </script>
</body>
</html>
