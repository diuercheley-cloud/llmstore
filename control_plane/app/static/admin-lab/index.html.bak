        function prepareKeyForClient(id) {
            document.getElementById('k-client').value = id;
            openModal('modal-key-create');
        }

        async function createKey() {
            const res = await apiFetch('/admin/api-keys', 'POST', {
                client_id: document.getElementById('k-client').value,
                name: document.getElementById('k-name').value,
            });
            closeModal('modal-key-create');
            state.apiKeys = await apiFetch('/admin/api-keys');
            renderKeysTable();
            revealSecret('Nova API key', res.api_key);
        }

        async function rotateKey(id) {
            const res = await apiFetch(`/admin/api-keys/${id}/rotate`, 'POST');
            state.apiKeys = await apiFetch('/admin/api-keys');
            renderKeysTable();
            revealSecret('API key rotacionada', res.api_key.api_key);
        }

        async function revokeKey(id) {
            if (!confirm('Revogar esta API key?')) return;
            await apiFetch(`/admin/api-keys/${id}`, 'DELETE');
            toast('API key revogada.', 'success');
            await loadTab('api-keys');
        }

        function revealSecret(title, secret) {
            const copyHint = '\n\nUse o botão OK e copie agora. Essa chave não será exibida novamente.';
            alert(`${title}\n\n${secret}${copyHint}`);
            navigator.clipboard?.writeText(secret).then(() => toast('Chave copiada para a área de transferência.')).catch(() => {});
        }

        async function createPlan() {
            await apiFetch('/admin/billing/plans', 'POST', {
                code: document.getElementById('plan-code').value,
                name: document.getElementById('plan-name').value,
                description: document.getElementById('plan-description').value,
                rate_limit_per_minute: Number(document.getElementById('plan-rpm').value),
                daily_token_quota: Number(document.getElementById('plan-daily').value),
                monthly_token_quota: Number(document.getElementById('plan-monthly').value),
                max_output_tokens: Number(document.getElementById('plan-max-output').value),
                allow_streaming: document.getElementById('plan-streaming').checked,
                is_active: true,
            });
            closeModal('modal-plan-create');
            toast('Plano criado.', 'success');
            await loadTab('plans');
        }

        async function editPlan(id) {
            const plan = state.plans.find((item) => item.id === id);
            if (!plan) return;
            const name = prompt('Nome do plano:', plan.name);
            if (name === null) return;
            await apiFetch(`/admin/billing/plans/${id}`, 'PATCH', { name });
            toast('Plano atualizado.', 'success');
            await loadTab('plans');
        }

        async function togglePlan(id, isActive) {
            await apiFetch(`/admin/billing/plans/${id}`, 'PATCH', { is_active: isActive });
            toast(`Plano ${isActive ? 'ativado' : 'desativado'}.`, 'success');
            await loadTab('plans');
        }

        async function generateInvoice() {
            const payload = {
                client_id: document.getElementById('invoice-client').value || null,
                due_in_days: Number(document.getElementById('invoice-due-days').value),
                payment_method: document.getElementById('invoice-payment-method').value,
                force: document.getElementById('invoice-force').checked,
            };
            await apiFetch('/admin/billing/invoices/generate', 'POST', payload);
            closeModal('modal-invoice-generate');
            toast('Invoice gerada.', 'success');
            await loadTab('invoices');
        }

        async function runBillingCycle() {
            const res = await apiFetch('/admin/billing/run-cycle', 'POST');
            toast(`Billing cycle executado: ${res.created_count} criadas.`, 'success');
            await refreshOverview();
            await loadTab('invoices');
        }

        async function markPaid(id) {
            await apiFetch(`/admin/billing/invoices/${id}/mark-paid`, 'PATCH', { payment_method: 'manual_admin_lab' });
            toast('Invoice marcada como paga.', 'success');
            await Promise.all([loadTab('invoices'), loadTab('payments')]);
        }

        async function markOverdue(id) {
            await apiFetch(`/admin/billing/invoices/${id}/mark-overdue`, 'PATCH');
            toast('Invoice marcada como overdue.', 'success');
            await loadTab('invoices');
        }

        async function cancelInvoice(id) {
            if (!confirm('Cancelar esta invoice?')) return;
            await apiFetch(`/admin/billing/invoices/${id}/cancel`, 'PATCH');
            toast('Invoice cancelada.', 'success');
            await loadTab('invoices');
        }

        async function createPayment() {
            await apiFetch('/admin/billing/payments', 'POST', {
                invoice_id: document.getElementById('p-invoice').value,
                amount: Number(document.getElementById('p-amount').value),
                payment_method: document.getElementById('p-method').value,
                payment_reference: document.getElementById('p-ref').value || null,
                paid_at: document.getElementById('p-paid').checked ? new Date().toISOString() : null,
            });
            closeModal('modal-payment-create');
            toast('Pagamento registrado.', 'success');
            await Promise.all([loadTab('payments'), loadTab('invoices')]);
        }

        async function cancelPayment(id) {
            if (!confirm('Cancelar este pagamento?')) return;
            await apiFetch(`/admin/billing/payments/${id}/cancel`, 'PATCH');
            toast('Pagamento cancelado.', 'success');
            await loadTab('payments');
        }

        async function resetUsage(id) {
            if (!confirm('Resetar uso e cotas do cliente?')) return;
            await apiFetch(`/admin/test/clients/${id}/reset-usage`, 'POST');
            toast('Uso resetado.', 'success');
        }

        function showClientUsage(id) {
            const client = (state.usageSummary?.clients || []).find((item) => item.client_id === id);
            if (!client) {
                toast('Uso ainda não disponível para este cliente.', 'error');
                return;
            }
            alert(JSON.stringify(client, null, 2));
        }

        function showClientInvoices(id) {
            document.getElementById('invoice-client-filter').value = id;
            switchTab('invoices');
            renderInvoicesTable();
        }

        function openCreateModelModal() {
            state.activeModelId = null;
            document.getElementById('model-modal-title').textContent = 'Adicionar Modelo';
            document.getElementById('m-model-id').disabled = false;
            document.getElementById('m-display-name').value = '';
            document.getElementById('m-model-id').value = '';
            document.getElementById('m-alias').value = '';
            document.getElementById('m-provider').value = 'llama.cpp';
            document.getElementById('m-file').innerHTML = fileOptionsHtml();
            updateModelFileStatus();
            refreshModelFiles(false);
            document.getElementById('m-prompt-template').value = 'auto';
            document.getElementById('m-backend').innerHTML = backendOptionsHtml();
            document.getElementById('m-context').value = '32768';
            document.getElementById('m-new-backend-name').value = '';
            document.getElementById('m-new-backend-url').value = '';
            document.getElementById('m-new-backend-provider').value = 'llama.cpp';
            document.getElementById('m-default').checked = false;
            document.getElementById('m-enabled').checked = true;
            document.getElementById('m-allow-reasoning').checked = false;
            document.getElementById('m-include-reasoning-default').checked = false;
            document.getElementById('m-plans').innerHTML = state.plans.map((plan) => `<option value="${plan.code}">${plan.code}</option>`).join('');
            openModal('modal-model-edit');
        }

        function openEditModelModal(id) {
            const model = (state.modelsPayload?.registry || []).find((item) => item.id === id);
            if (!model) return;
            state.activeModelId = id;
            document.getElementById('model-modal-title').textContent = 'Editar Modelo';
            document.getElementById('m-display-name').value = model.display_name || '';
            document.getElementById('m-model-id').value = model.model_id || '';
            document.getElementById('m-model-id').disabled = true;
            document.getElementById('m-alias').value = model.model_alias || '';
            document.getElementById('m-provider').value = model.provider || 'llama.cpp';
            document.getElementById('m-file').innerHTML = fileOptionsHtml(model.model_file || '');
            updateModelFileStatus();
            refreshModelFiles(false, model.model_file || '');
            document.getElementById('m-prompt-template').value = model.prompt_template || 'auto';
            document.getElementById('m-backend').innerHTML = backendOptionsHtml(model.inference_backend_id || '');
            document.getElementById('m-context').value = model.context_length || 32768;
            document.getElementById('m-new-backend-name').value = '';
            document.getElementById('m-new-backend-url').value = '';
            document.getElementById('m-new-backend-provider').value = 'llama.cpp';
            document.getElementById('m-default').checked = !!model.is_default;
            document.getElementById('m-enabled').checked = !!model.is_active;
            document.getElementById('m-allow-reasoning').checked = !!model.allow_reasoning;
            document.getElementById('m-include-reasoning-default').checked = !!model.include_reasoning_default;
            const plans = state.plans.map((plan) => {
                const allowed = parseJsonList((state.modelsPayload?.plan_access || []).find((item) => item.billing_plan_code === plan.code)?.allowed_models_json || '');
                const isSelected = allowed.includes(model.model_id) || (model.model_alias && allowed.includes(model.model_alias));
                return `<option value="${plan.code}" ${isSelected ? 'selected' : ''}>${plan.code}</option>`;
            }).join('');
            document.getElementById('m-plans').innerHTML = plans;
            openModal('modal-model-edit');
        }

        function duplicateModelConfig(id) {
            const model = (state.modelsPayload?.registry || []).find((item) => item.id === id);
            if (!model) return;
            openCreateModelModal();
            document.getElementById('m-display-name').value = `${model.display_name || model.model_alias || model.model_id} Copy`;
            document.getElementById('m-model-id').value = `${model.model_id}-copy`;
            document.getElementById('m-alias').value = model.model_alias ? `${model.model_alias}-copy` : '';
            document.getElementById('m-provider').value = model.provider || 'llama.cpp';
            document.getElementById('m-file').innerHTML = fileOptionsHtml(model.model_file || '');
            updateModelFileStatus();
            refreshModelFiles(false, model.model_file || '');
            document.getElementById('m-prompt-template').value = model.prompt_template || 'auto';
            document.getElementById('m-backend').innerHTML = backendOptionsHtml(model.inference_backend_id || '');
            document.getElementById('m-context').value = model.context_length || 32768;
            document.getElementById('m-allow-reasoning').checked = !!model.allow_reasoning;
            document.getElementById('m-include-reasoning-default').checked = !!model.include_reasoning_default;
        }

        async function saveModel() {
            const createBackendName = document.getElementById('m-new-backend-name').value.trim();
            const createBackendUrl = document.getElementById('m-new-backend-url').value.trim();
            const selectedModelFile = document.getElementById('m-file').value.trim();
            if (!selectedModelFile) {
                toast(state.modelFiles?.error || state.modelFiles?.warning || 'Selecione um arquivo .gguf em /models.', 'error');
                return;
            }
            const payload = {
                display_name: document.getElementById('m-display-name').value.trim() || null,
                model_id: document.getElementById('m-model-id').value.trim(),
                model_alias: document.getElementById('m-alias').value.trim() || null,
                provider: document.getElementById('m-provider').value,
                model_file: selectedModelFile,
                inference_backend_id: document.getElementById('m-backend').value || null,
                context_length: Number(document.getElementById('m-context').value || 32768),
                prompt_template: document.getElementById('m-prompt-template').value,
                is_default: document.getElementById('m-default').checked,
                is_active: document.getElementById('m-enabled').checked,
                allow_reasoning: document.getElementById('m-allow-reasoning').checked,
                include_reasoning_default: document.getElementById('m-include-reasoning-default').checked,
                allowed_plan_codes: selectedValues(document.getElementById('m-plans')),
            };
            if (createBackendName && createBackendUrl) {
                payload.create_backend = {
                    name: createBackendName,
                    provider: document.getElementById('m-new-backend-provider').value,
                    backend_url: createBackendUrl,
                    healthcheck_path: '/health',
                    is_active: true,
                    is_default: false,
                    status: 'configured',
                    max_parallel_requests: 1,
                };
            }
            if (state.activeModelId) {
                payload.is_default = document.getElementById('m-default').checked;
                payload.is_active = document.getElementById('m-enabled').checked;
                await apiFetch(`/admin/models/${state.activeModelId}`, 'PATCH', payload);
                document.getElementById('m-model-id').disabled = false;
                toast('Modelo atualizado.', 'success');
            } else {
                await apiFetch('/admin/models', 'POST', payload);
                toast('Modelo criado.', 'success');
            }
            closeModal('modal-model-edit');
            document.getElementById('m-model-id').disabled = false;
            await loadTab('models');
        }

        async function makeDefaultModel(id) {
            await apiFetch(`/admin/models/${id}/set-default`, 'POST');
            toast('Modelo default atualizado.', 'success');
            await loadTab('models');
        }

        function showModelRoutes(id) {
            const model = (state.modelsPayload?.registry || []).find((item) => item.id === id);
            if (!model) return;
            alert(JSON.stringify(model.routes || [], null, 2));
        }

        async function removeModel(id) {
            const confirmWord = prompt('Digite REMOVER para confirmar a remoção do modelo.');
            if (confirmWord !== 'REMOVER') return;
            const soft = confirm('Usar remoção segura (soft delete) se houver histórico?');
            await apiFetch(`/admin/models/${id}`, 'DELETE', {
                confirm_route_removal: true,
                mode: soft ? 'auto' : 'register-only',
            });
            toast('Modelo removido.', 'success');
            await loadTab('models');
        }

        function openTestModelModal(id) {
            state.activeModelId = id;
            document.getElementById('mt-result').textContent = 'Aguardando teste...';
            openModal('modal-model-test');
        }

        async function runModelPromptTest() {
            if (!state.activeModelId) return;
            const payload = {
                prompt: document.getElementById('mt-prompt').value,
                max_tokens: Number(document.getElementById('mt-max-tokens').value || 96),
                temperature: Number(document.getElementById('mt-temperature').value || 0.2),
                stream: document.getElementById('mt-stream').checked,
                include_reasoning: document.getElementById('mt-include-reasoning').checked,
            };
            const result = await apiFetch(`/admin/models/${state.activeModelId}/test-prompt`, 'POST', payload);
            document.getElementById('mt-result').textContent = JSON.stringify(result, null, 2);
        }

        async function showBackendHealthFromModel(id) {
            const model = (state.modelsPayload?.registry || []).find((item) => item.id === id);
            if (!model?.inference_backend_id) {
                toast('Modelo sem backend associado.', 'error');
                return;
            }
            await viewBackendHealth(model.inference_backend_id);
        }

        async function showBackendLogsFromModel(id) {
            const model = (state.modelsPayload?.registry || []).find((item) => item.id === id);
            if (!model?.inference_backend_id) {
                toast('Modelo sem backend associado.', 'error');
                return;
            }
            await viewBackendLogs(model.inference_backend_id);
        }

        function openCreateBackendModal() {
            state.activeBackendId = null;
            document.getElementById('backend-modal-title').textContent = 'Adicionar Backend';
            document.getElementById('b-name').value = '';
            document.getElementById('b-provider').value = 'llama.cpp';
            document.getElementById('b-url').value = '';
            document.getElementById('b-health').value = '/health';
            document.getElementById('b-parallel').value = '1';
            document.getElementById('b-active').checked = true;
            openModal('modal-backend-edit');
        }

        function openEditBackendModal(id) {
            const backend = (state.backends || []).find((item) => item.id === id);
            if (!backend) return;
            state.activeBackendId = id;
            document.getElementById('backend-modal-title').textContent = 'Editar Backend';
            document.getElementById('b-name').value = backend.name;
            document.getElementById('b-provider').value = backend.provider;
            document.getElementById('b-url').value = backend.backend_url;
            document.getElementById('b-health').value = backend.healthcheck_path || '/health';
            document.getElementById('b-parallel').value = backend.max_parallel_requests || 1;
            document.getElementById('b-active').checked = !!backend.is_active;
            openModal('modal-backend-edit');
        }

        async function saveBackend() {
            const payload = {
                name: document.getElementById('b-name').value.trim(),
                provider: document.getElementById('b-provider').value,
                backend_url: document.getElementById('b-url').value.trim(),
                healthcheck_path: document.getElementById('b-health').value.trim() || '/health',
                is_active: document.getElementById('b-active').checked,
                is_default: false,
                status: 'configured',
                max_parallel_requests: Number(document.getElementById('b-parallel').value || 1),
            };
            if (state.activeBackendId) {
                await apiFetch(`/admin/backends/${state.activeBackendId}`, 'PATCH', payload);
                toast('Backend atualizado.', 'success');
            } else {
                await apiFetch('/admin/backends', 'POST', payload);
                toast('Backend criado.', 'success');
            }
            closeModal('modal-backend-edit');
            await loadTab('backends');
            await loadTab('models');
        }

        async function toggleBackendActive(id, isActive) {
            await apiFetch(`/admin/backends/${id}`, 'PATCH', { is_active: isActive, status: isActive ? 'configured' : 'disabled' });
            toast(`Backend ${isActive ? 'ativado' : 'desativado'}.`, 'success');
            await loadTab('backends');
            await loadTab('models');
        }

        async function runBackendAction(id, action) {
            await apiFetch(`/admin/backends/${id}/${action}`, 'POST');
            toast(`Backend ${action} executado.`, 'success');
            await loadTab('backends');
            await loadTab('models');
        }

        async function viewBackendHealth(id) {
