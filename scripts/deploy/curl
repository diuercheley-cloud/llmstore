#!/usr/bin/env python3
"""Portable curl-compatible wrapper for local validation scripts."""

from __future__ import annotations

import os
import ssl
import sys
from dataclasses import dataclass, field
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen


@dataclass
class CurlArgs:
    method: str = "GET"
    headers: list[tuple[str, str]] = field(default_factory=list)
    data: bytes | None = None
    output: str | None = None
    write_out: str | None = None
    head_only: bool = False
    fail_on_error: bool = False
    insecure: bool = False
    url: str | None = None


def _delegate_to_system_curl() -> None:
    system_curl = os.environ.get("SYSTEM_CURL")
    if system_curl and os.path.exists(system_curl) and os.access(system_curl, os.X_OK):
        os.execv(system_curl, [system_curl, *sys.argv[1:]])


def _parse_args(argv: list[str]) -> CurlArgs:
    out = CurlArgs()
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("-") and not arg.startswith("--") and len(arg) > 2 and arg[1] not in {"H", "X", "d", "o", "w"}:
            for ch in arg[1:]:
                if ch in {"s", "S", "L", "N"}:
                    continue
                if ch == "f":
                    out.fail_on_error = True
                elif ch == "k":
                    out.insecure = True
            i += 1
            continue
        if arg in {"-s", "-S", "-L", "-N"}:
            i += 1
            continue
        if arg == "-f" or arg == "--fail":
            out.fail_on_error = True
            i += 1
            continue
        if arg == "-k" or arg == "--insecure":
            out.insecure = True
            i += 1
            continue
        if arg == "-I" or arg == "--head":
            out.head_only = True
            out.method = "HEAD"
            i += 1
            continue
        if arg == "-X":
            out.method = argv[i + 1].upper()
            i += 2
            continue
        if arg in {"-H", "--header"}:
            header = argv[i + 1]
            name, value = header.split(":", 1)
            out.headers.append((name.strip(), value.strip()))
            i += 2
            continue
        if arg in {"-d", "--data", "--data-raw", "--data-binary"}:
            out.data = argv[i + 1].encode()
            if out.method == "GET":
                out.method = "POST"
            i += 2
            continue
        if arg == "--data-urlencode":
            encoded = argv[i + 1]
            if "=" in encoded:
                key, value = encoded.split("=", 1)
                payload = urlencode({key: value})
            else:
                payload = encoded
            out.data = payload.encode()
            if out.method == "GET":
                out.method = "POST"
            i += 2
            continue
        if arg == "-o":
            out.output = argv[i + 1]
            i += 2
            continue
        if arg == "-w":
            out.write_out = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            # Ignore unsupported flags that the local scripts do not rely on.
            if i + 1 < len(argv) and not argv[i + 1].startswith("-") and arg not in {"-s", "-S", "-L", "-N"}:
                # Best-effort skip for option/value pairs.
                i += 2
            else:
                i += 1
            continue
        out.url = arg
        i += 1
    return out


def main() -> int:
    if len(sys.argv) == 1:
        return 0

    _delegate_to_system_curl()

    args = _parse_args(sys.argv[1:])
    if not args.url:
        return 2

    req = Request(args.url, method=args.method)
    for name, value in args.headers:
        req.add_header(name, value)
    if args.data is not None:
        req.data = args.data

    context = ssl._create_unverified_context() if args.insecure else None

    try:
        with urlopen(req, timeout=5, context=context) as resp:
            body = resp.read()
            status = getattr(resp, "status", 200)
            if args.output == "/dev/null":
                pass
            elif args.output:
                with open(args.output, "wb") as f:
                    f.write(body)
            else:
                sys.stdout.buffer.write(body)
            if args.write_out:
                sys.stdout.write(args.write_out.replace("%{http_code}", str(status)))
            return 0
    except HTTPError as exc:
        if args.output == "/dev/null":
            pass
        elif args.output:
            with open(args.output, "wb") as f:
                f.write(exc.read())
        elif not args.fail_on_error:
            sys.stdout.buffer.write(exc.read())
        if args.write_out:
            sys.stdout.write(args.write_out.replace("%{http_code}", str(exc.code)))
        return 22 if args.fail_on_error else 0
    except URLError:
        if args.write_out:
            sys.stdout.write(args.write_out.replace("%{http_code}", "000"))
        return 7


if __name__ == "__main__":
    raise SystemExit(main())
