{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Agent Run Success Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "options": {
        "min": 0, "max": 100,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 80 },
            { "color": "green", "value": 95 }
          ]
        }
      },
      "targets": [
        { "expr": "avg(llm_agent_run_success_rate) * 100" }
      ]
    },
    {
      "title": "Active Runs",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(llm_agent_runs_total{status='started'}) - sum(llm_agent_runs_total{status=~'completed|failed'})" }
      ]
    },
    {
      "title": "Run Volume (by Agent)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(llm_agent_runs_total[1m])) by (agent_id)" }
      ]
    },
    {
      "title": "Plan Depth Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "llm_agent_plan_depth" }
      ]
    },
    {
      "title": "Replans (Counter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(llm_agent_replan_total[5m])) by (agent_id)" }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["agentic", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Agentic Operations Overview",
  "uid": "agentic-overview",
  "version": 1
}
