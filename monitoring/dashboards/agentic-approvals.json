  "panels": [
    {
      "title": "Approval Wait Time (Avg)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "avg(llm_agent_approval_wait_seconds_sum / llm_agent_approval_wait_seconds_count)" }
      ]
    },
    {
      "title": "Approval Backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        { "expr": "llm_agent_runs_total{status='waiting_approval'}" }
      ]
    },
    {
      "title": "Policy Denials",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(llm_agent_policy_denials_total[5m])) by (agent_id, tool_name)" }
      ]
    }
