{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "title": "Tool Execution Latency (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(llm_agent_tool_latency_seconds_bucket[5m])) by (le, tool_name))" }
      ]
    },
    {
      "title": "Tool Failure Rate",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "avg(llm_agent_tool_failure_rate) by (tool_name)" }
      ]
    },
    {
      "title": "Tool Call Volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(llm_agent_tool_duration_seconds_count[1m])) by (tool_name)" }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
