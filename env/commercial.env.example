# Commercial & Billing Configuration
# Use this for pilot or production deployments requiring quotas, margins, and cloud providers.

# --- Cloud Provider Enablement ---
CLOUD_PROVIDERS_ENABLED=false
OPENAI_PROVIDER_ENABLED=false
DEEPSEEK_PROVIDER_ENABLED=false
ANTHROPIC_PROVIDER_ENABLED=false
GEMINI_PROVIDER_ENABLED=false

# --- Billing & Quotas ---
BILLING_INVOICE_DAY=1
BILLING_DUE_DAYS=7
BILLING_SUSPEND_AFTER_DAYS=15

# --- Commercial Guardrails ---
COMMERCIAL_GUARDRAILS_ENABLED=false
MAX_GLOBAL_PROVIDER_COST_PER_DAY_BRL=50.00
MAX_CLIENT_PROVIDER_COST_PER_DAY_BRL=5.00
MAX_PROVIDER_COST_PER_DAY_BRL=0
MARGIN_WARNING_PERCENT=20
NEGATIVE_MARGIN_BLOCK_MODE=report_only
GLOBAL_CLOUD_KILL_SWITCH=false

# --- Real Provider Validation ---
REAL_PROVIDER_VALIDATION_ENABLED=false
REAL_PROVIDER_MAX_COST_BRL=2.00
REAL_PROVIDER_TIMEOUT_SECONDS=30
REAL_PROVIDER_LOG_PROMPTS=false
REAL_PROVIDER_STORE_RESPONSES=false

# --- Commercial HA / Leader Election ---
COMMERCIAL_LEADER_ELECTION_ENABLED=true
COMMERCIAL_LEASE_DURATION_SECONDS=60
COMMERCIAL_LEASE_HEARTBEAT_SECONDS=15
COMMERCIAL_LEASE_RENEW_BEFORE_SECONDS=20
