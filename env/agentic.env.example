# Agentic AI Platform Configuration
# Use this for deployments requiring autonomous agents, tools, and memory.

# --- Core Agent Runtime ---
AGENT_RUNTIME_ENABLED=false
AGENT_WORKER_ENABLED=false
AGENT_EXECUTION_ENABLED=false
AGENT_ASYNC_EXECUTION_ENABLED=false

# --- Tooling & Sandboxing ---
AGENT_TOOL_REGISTRY_ENABLED=false
AGENT_TOOL_EXECUTION_ENABLED=false
AGENT_TOOL_ADAPTERS_ENABLED=false
AGENT_TOOL_SANDBOX_ENABLED=true
AGENT_CODE_INTERPRETER_ENABLED=false
AGENT_CODE_SANDBOX_PROVIDER=mock

# --- Memory & Context ---
AGENT_MEMORY_ENABLED=false
AGENT_WORKING_MEMORY_ENABLED=false
AGENT_COGNITIVE_MEMORY_ENABLED=false
AGENT_LONG_TERM_MEMORY_ENABLED=false
AGENT_MEMORY_SEMANTIC_SEARCH_ENABLED=false

# --- Governance & Approvals ---
AGENT_HUMAN_APPROVAL_ENABLED=true
AGENT_APPROVAL_REQUIRED_FOR_HIGH_RISK=true
AGENT_INCIDENT_RESPONSE_ENABLED=true
