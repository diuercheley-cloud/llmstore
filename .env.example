# LLM Inference Stack - Minimal Local Appliance Configuration
# For advanced features, see env/*.env.example

# --- Project Identity ---
PROJECT_NAME=local-llm-inference-stack
APP_ENV=local
OPERATIONAL_PROFILE=lite

# --- API Connectivity ---
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8080
APP_PUBLIC_URL=http://localhost:18080
DEBUG=false
LOG_LEVEL=INFO

# --- Security (REQUIRED: Change these for production) ---
ADMIN_TOKEN=QuickstartAdminToken-ChangeMe-1234
JWT_SECRET=quickstart-jwt-secret-change-me

# --- Databases ---
DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway_dev_password@postgres:5432/llm_gateway
REDIS_URL=redis://redis:6379/0

# --- Inference Settings ---
DATA_PLANE_BASE_URL=http://data-plane-gemma:8081
MODEL_ID=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_0.gguf

# --- RAG Settings ---
RAG_ENABLED=true
RAG_STORAGE_DIR=/data/rag_uploads
RAG_EMBEDDING_PROVIDER=local

# --- Cache ---
RESPONSE_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=false
