PROJECT_NAME=local-llm-inference-stack
DEBUG=false
LOG_LEVEL=INFO
HOST_PORT=18080
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8080
ADMIN_TOKEN=ChangeMe_ProdAdminToken_2026!
CORS_ALLOW_ORIGINS=
PUBLIC_EXPOSURE=false
PUBLIC_SIGNUP_ENABLED=true
APP_ENV=local-production
LOCALHOST_MODE=true
APP_PUBLIC_URL=http://localhost:18080
PUBLIC_API_ENABLED=true
PUBLIC_BASE_URL=http://localhost:18080
ADMIN_BASE_URL=http://localhost:18080/admin
CLIENT_PORTAL_BASE_URL=http://localhost:18080/client-portal
DOCS_BASE_URL=http://localhost:18080/docs
API_BASE_URL=http://localhost:18080/v1
PUBLIC_BRAND_NAME=LLM Inference Stack Cloud
PUBLIC_SUPPORT_EMAIL=sales@example.com
POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=llm_gateway_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway_dev_password@postgres:5432/llm_gateway
REDIS_URL=redis://redis:6379/0
DATA_PLANE_BASE_URL=http://data-plane-gemma:8081
OLLAMA_BASE_URL=http://data-plane-ollama:11434
DATA_PLANE_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=180
QUEUE_TIMEOUT_SECONDS=30
MAX_CONCURRENT_GENERATIONS=1
MAX_QUEUE_SIZE=2
MAX_CONTEXT_TOKENS=32768
MAX_INPUT_TOKENS=2048
DEFAULT_MAX_TOKENS=512
MAX_COMPLETION_TOKENS=1024
MAX_TOKENS_LIMIT=1024
DEFAULT_TEMPERATURE=0.7
MAX_TEMPERATURE=1.5
DEFAULT_TOP_P=0.95
MAX_TOP_P=1.0
RETRY_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=1.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=20
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=false
BILLING_INVOICE_DAY=1
BILLING_DUE_DAYS=7
BILLING_SUSPEND_AFTER_DAYS=15

# --- Demo Mode ---
DEMO_MODE=false
DEMO_CLIENT_EMAIL=demo@example.local
DEMO_CLIENT_NAME="Cliente Demo Local"
DEMO_PLAN=demo-pro

MODEL_ID=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_0.gguf
LLAMA_CTX_SIZE=2048
LLAMA_N_GPU_LAYERS=20
LLAMA_THREADS=8
LLAMA_BATCH_SIZE=128
LLAMA_UBATCH_SIZE=64
LLAMA_PARALLEL=1
LLAMA_CONT_BATCHING=true
LLAMA_FLASH_ATTN=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
SERVER_NAME=api.example.com
LETSENCRYPT_EMAIL=ops@example.com
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Abuse Detection
ABUSE_DETECTION_ENABLED=true
ABUSE_AUTO_SUSPEND_ENABLED=false
ABUSE_DRY_RUN=true

# RAG Configuration
RAG_ENABLED=true
RAG_STORAGE_DIR=/data/rag_uploads
RAG_MAX_FILE_MB=25
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K_DEFAULT=5
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Real Provider Validation (v1.8.1) ---
# All real provider calls require explicit opt-in.
# REAL_PROVIDER_VALIDATION_ENABLED must be true for any outbound request.
# API keys go ONLY in .env.local — NEVER in .env.example or committed files.
REAL_PROVIDER_VALIDATION_ENABLED=false
REAL_PROVIDER_MAX_COST_BRL=2.00
REAL_PROVIDER_TIMEOUT_SECONDS=30
REAL_PROVIDER_LOG_PROMPTS=false
REAL_PROVIDER_STORE_RESPONSES=false

# OpenAI
OPENAI_PROVIDER_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDINGS_MODEL=

# DeepSeek
DEEPSEEK_PROVIDER_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=

# Anthropic
ANTHROPIC_PROVIDER_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
